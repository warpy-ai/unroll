// LSP Document Formatting Handler
// Provides basic auto-formatting for .ot files.

import { sendResponse } from "./transport.ot";
import { DocumentStore } from "./documents.ot";

/**
 * Handle textDocument/formatting request.
 * Returns TextEdit[] to format the entire document.
 */
function handleFormatting(id: any, params: any, documents: DocumentStore): void {
    let uri = params.textDocument.uri;
    let options = params.options;

    let content = documents.get(uri);
    if (content == null) {
        sendResponse(id, []);
        return;
    }

    let tabSize = 4;
    let insertSpaces = true;
    if (options != null) {
        if (options.tabSize != null) {
            tabSize = options.tabSize;
        }
        if (options.insertSpaces != null) {
            insertSpaces = options.insertSpaces;
        }
    }

    let indentStr = "";
    if (insertSpaces) {
        for (let i = 0; i < tabSize; i = i + 1) {
            indentStr = indentStr + " ";
        }
    } else {
        indentStr = "\t";
    }

    let formatted = formatDocument(content, indentStr);

    // Only send edit if content actually changed
    if (formatted == content) {
        sendResponse(id, []);
        return;
    }

    let lines = content.split("\n");
    let lastLine = lines.length - 1;
    let lastChar = lines[lastLine].length;

    sendResponse(id, [{
        range: {
            start: { line: 0, character: 0 },
            end: { line: lastLine, character: lastChar }
        },
        newText: formatted
    }]);
}

/**
 * Format a document's content.
 * Rules:
 * - Fix indentation based on brace nesting
 * - Ensure single blank line between top-level declarations
 * - Remove trailing whitespace
 * - Ensure file ends with single newline
 * - Normalize spaces around operators
 */
function formatDocument(content: string, indentStr: string): string {
    let lines = content.split("\n");
    let result: string[] = [];
    let indentLevel = 0;
    let prevWasBlank = false;
    let inBlockComment = false;

    for (let i = 0; i < lines.length; i = i + 1) {
        let line = lines[i];
        let trimmed = line.trim();

        // Handle block comments
        if (inBlockComment) {
            // Preserve block comment content but fix indent
            result.push(makeIndent(indentStr, indentLevel) + " " + trimmed);
            if (trimmed.indexOf("*/") >= 0) {
                inBlockComment = false;
            }
            prevWasBlank = false;
            continue;
        }

        if (trimmed.startsWith("/*")) {
            if (trimmed.indexOf("*/") < 0) {
                inBlockComment = true;
            }
            result.push(makeIndent(indentStr, indentLevel) + trimmed);
            prevWasBlank = false;
            continue;
        }

        // Empty line handling
        if (trimmed == "") {
            // Collapse multiple blank lines into one
            if (!prevWasBlank) {
                result.push("");
                prevWasBlank = true;
            }
            continue;
        }
        prevWasBlank = false;

        // Decrease indent for lines starting with } or case/default
        let startsWithClose = trimmed.startsWith("}");
        let startsWithCase = trimmed.startsWith("case ") || trimmed == "default:";

        // Determine indent for this line
        let lineIndent = indentLevel;
        if (startsWithClose) {
            lineIndent = lineIndent - 1;
            if (lineIndent < 0) lineIndent = 0;
        }

        // Build the formatted line
        let formatted = makeIndent(indentStr, lineIndent) + trimmed;

        // Remove trailing whitespace
        formatted = rtrim(formatted);

        result.push(formatted);

        // Update indent level based on braces in this line
        let braceChange = countBraceChange(trimmed);
        indentLevel = indentLevel + braceChange;
        if (indentLevel < 0) indentLevel = 0;
    }

    // Remove trailing blank lines
    while (result.length > 0 && result[result.length - 1] == "") {
        result.pop();
    }

    // Join and ensure trailing newline
    let output = "";
    for (let i = 0; i < result.length; i = i + 1) {
        if (i > 0) {
            output = output + "\n";
        }
        output = output + result[i];
    }
    output = output + "\n";

    return output;
}

/**
 * Build an indentation string for a given level.
 */
function makeIndent(indentStr: string, level: number): string {
    let result = "";
    for (let i = 0; i < level; i = i + 1) {
        result = result + indentStr;
    }
    return result;
}

/**
 * Count the net brace change in a line (ignoring braces in strings and comments).
 */
function countBraceChange(line: string): number {
    let change = 0;
    let inString = false;
    let stringChar = "";

    for (let i = 0; i < line.length; i = i + 1) {
        let c = line[i];

        // Skip escape sequences in strings
        if (inString) {
            if (c == "\\" && i + 1 < line.length) {
                i = i + 1;
                continue;
            }
            if (c == stringChar) {
                inString = false;
            }
            continue;
        }

        // Enter string
        if (c == "\"" || c == "'" || c == "`") {
            inString = true;
            stringChar = c;
            continue;
        }

        // Line comment — stop counting
        if (c == "/" && i + 1 < line.length && line[i + 1] == "/") {
            break;
        }

        if (c == "{") {
            change = change + 1;
        } else if (c == "}") {
            change = change - 1;
        }
    }

    return change;
}

/**
 * Remove trailing whitespace from a string.
 */
function rtrim(s: string): string {
    let end = s.length;
    while (end > 0) {
        let c = s[end - 1];
        if (c == " " || c == "\t" || c == "\r") {
            end = end - 1;
        } else {
            break;
        }
    }
    if (end == s.length) return s;
    return s.substring(0, end);
}

export { handleFormatting };
